# Copy to .env.live and fill in. Never commit .env.live.
#
# Everything the LIVE engine needs that differs from the demo lab. The live task
# runs:
#
#     python.exe scripts\run_engine.py --env-file C:\ForexAI\.env.live
#
# so this file - not a PowerShell wrapper - is what makes that process the live
# engine. That matters: Task Scheduler now owns the engine directly, exactly as
# it does for the demo lab, so `Stop-ScheduledTask` stops the real thing and a
# restart is one command instead of a process hunt. (It used to launch
# infra/run-live-engine.ps1, which exported these and then started python - so
# stopping the task killed the wrapper and left the engine running, reparented.
# Starting it again gave you two live engines on one account.)
#
# Values here are read only if the same name is not already a real environment
# variable - pydantic-settings precedence is env > file > default, unchanged.
#
# THE ENGINE REFUSES TO START if MT5_LOGIN / MT5_PASSWORD / MT5_SERVER /
# MT5_TERMINAL_PATH are empty, or the terminal path is not a file, or TEST_MODE
# is true on a live account. Those checks moved into scripts/run_engine.py and
# engine/loop.py when the wrapper stopped being on the startup path - a guard
# that lives only in a launcher you no longer use is not a guard.
#
# None of this is a live-TRADING guard. The four guards are unchanged and all
# still apply; see docs/going-live.md.

# --- Which account this process IS -------------------------------------------
# Without this the engine defaults to icmarkets-demo and would tell the LIVE
# terminal to trade the demo account while tagging everything 'live'.
ACCOUNT_KEY=icmarkets-live

# --- The live account's own MT5 terminal --------------------------------------
# A SECOND MT5 installation, separate from the demo one. MetaTrader5's bridge
# attaches to one terminal per process and mt5.initialize(path=...) is what
# disambiguates them.
MT5_TERMINAL_PATH=C:\Program Files\MetaTrader 5 IC Markets Live\terminal64.exe

# --- LIVE account credentials --------------------------------------------------
# The repo's .env holds the DEMO login; these override it for this process.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Sizing --------------------------------------------------------------------
# NOT a safety guard - it picks the sizing STYLE. false = real risk-based sizing
# from strategy_accounts.risk_pct, which is the only correct setting on a live
# account. true would place real orders at the broker's minimum volume and
# ignore your risk budget; the engine refuses to start that way.
TEST_MODE=false

# --- Live behaviour differences ------------------------------------------------
# The demo default (12) is tuned for the lab's data collection rate. On real
# money a tight cap is a risk control, not a data-rate knob.
MAX_CONCURRENT_TRADES=2

# The demo engine already sends one daily digest covering both accounts.
DAILY_SUMMARY_ENABLED=false

# --- The master live-trading guard ---------------------------------------------
# Guard 1 of 4. Off unless this says true. Account-wide: while it is false, no
# strategy can place a real order regardless of readiness or per-strategy
# toggles. Turning it on is a deliberate act - see docs/going-live.md.
LIVE_TRADING_ENABLED=false
