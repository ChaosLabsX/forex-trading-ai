.env
# Live-account credentials, loaded by infra/run-live-engine.ps1. Listed
# explicitly because the '.env' rule above matches that exact filename only -
# it would NOT cover this. The .example files stay committed.
.env.live
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
dist/
build/

dashboard/node_modules/
dashboard/dist/

.vscode/
.idea/
*.log

# Design source files (large binaries) - not needed to build/run the app
Illustrator/

# Runtime pid files written by scripts/run_engine.py (logs/engine-<account>.pid).
# Machine-local and must never be committed: a pulled pid file would point the
# restart script at a PID from a different machine.
*.pid
